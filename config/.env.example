# Copy to /data/qqbot/compose/.env and edit. NEVER commit the real .env.
#   cp .env.example .env && vi .env
#
# Every value marked CHANGE_ME must be regenerated for your deployment.
# The values shipped here are placeholders from a throwaway test box.

# ---------------------------------------------------------------- SnowLuma
SNOWLUMA_IMAGE=motricseven7/snowluma:latest
SNOWLUMA_CONTAINER=snowluma

# noVNC password for the QR-scan page. CHANGE_ME.
VNC_PASSWD=CHANGE_ME_novnc_password

SNOWLUMA_UID=1000
SNOWLUMA_GID=1000
SNOWLUMA_WEBUI_PORT=5099
NOVNC_PORT=6081

# QQ Chromium launch flags.
# DO NOT restore --disable-software-rasterizer: on a headless Xvfb screen it
# removes the last paint path and the login window stays a blank gray box with
# no QR code (see docs/06-pitfalls.md P-04).
# SNOWLUMA_QQ_FLAGS=--disable-gpu --disable-gpu-compositing --enable-unsafe-swiftshader --disable-dev-shm-usage

# ---------------------------------------------------------------- OneBot
# Shared secret for OneBot HTTP + WS. CHANGE_ME.
# Must match, on all three sides:
#   snowluma  /app/data/config/onebot.json -> networks.httpServers[].accessToken
#   snowluma  ...                         -> networks.wsServers[].accessToken
#   surfcore  config.json                 -> snowluma.accessToken
ONEBOT_ACCESS_TOKEN=CHANGE_ME_onebot_token

# ---------------------------------------------------------------- owner / allowlist
OWNER_QQ=1000000001

# ---------------------------------------------------------------- timezone
# The bridge schedules daily jobs (e.g. Bilibili share times) against this TZ.
# Leaving the host on UTC silently shifts every "07:00" by 8 hours.
TZ=Asia/Shanghai

# ---------------------------------------------------------------- optional: AstrBot (deprecated)
# Kept only so `docker compose stop astrbot` has something to stop.
ASTRBOT_IMAGE=soulter/astrbot:latest
ASTRBOT_WEBUI_PORT=6185
ASTRBOT_WS_REVERSE_PORT=6199

# ---------------------------------------------------------------- optional: dsh-llm-gateway (deprecated)
# WARNING: this component routes through the account owner's own DeepSeek
# credentials. Leave it stopped (see docs/07-optional.md 7.2).
GATEWAY_TOKEN=CHANGE_ME_gateway_token
GATEWAY_PORT=8790

# ---------------------------------------------------------------- stage 3 (SurfCore in a container)
# Only used when the bridge runs as a container instead of a systemd unit.
# It MUST resolve to a loopback address, otherwise the DSH cookie minting path
# is skipped and every request gets 401 (docs/01-architecture.md 1.1).
DSH_BASE_URL=http://127.0.0.1:3080
